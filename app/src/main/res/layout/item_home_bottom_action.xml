<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/ivBottomActionIcon"
        android:layout_width="@dimen/home_bottom_action_icon_size"
        android:layout_height="@dimen/home_bottom_action_icon_size"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/tvBottomActionLabel"
        style="@style/AppGolosText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/home_bottom_action_icon_gap"
        android:includeFontPadding="false"
        android:textColor="#FFFFFF"
        android:textFontWeight="500" />

</LinearLayout>
