<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_glass_panel"
    android:orientation="vertical"
    android:padding="14dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/WhiteTitleTextShadow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Плейлисты"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spPlaylist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#22FFFFFF" />

            <EditText
                android:id="@+id/etPlaylistName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="Название плейлиста"
                android:textColor="#FFFFFF"
                android:textColorHint="#99FFFFFF" />

            <RadioGroup
                android:id="@+id/rgSourceType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbToken"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Токен"
                    android:textColor="#FFFFFF" />

                <RadioButton
                    android:id="@+id/rbUrl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="URL"
                    android:textColor="#FFFFFF" />
            </RadioGroup>

            <EditText
                android:id="@+id/etSourceValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#99FFFFFF" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnAddOrUpdatePlaylist"
                    style="@style/WhiteTitleTextShadow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_watch_button"
                    android:gravity="center"
                    android:padding="10dp"
                    android:text="Сохранить"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnApplyPlaylist"
                    style="@style/WhiteTitleTextShadow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_watch_button"
                    android:gravity="center"
                    android:padding="10dp"
                    android:text="Применить"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnDeletePlaylist"
                    style="@style/WhiteTitleTextShadow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_watch_button"
                    android:gravity="center"
                    android:padding="10dp"
                    android:text="Удалить"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/btnClosePlaylistDialog"
        style="@style/WhiteTitleTextShadow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_watch_button"
        android:gravity="center"
        android:padding="10dp"
        android:text="Закрыть"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />
</LinearLayout>
