<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tvProgramTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="12dp"
            android:minWidth="60dp"
            android:gravity="center"
            android:background="@drawable/epg_time_badge_bg"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:fontFamily="@font/golos_text"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textFontWeight="500"
            tools:text="20:00" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvProgramTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="340dp"
                    android:fontFamily="@font/golos_text"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textFontWeight="500"
                    android:singleLine="true"
                    android:ellipsize="end"
                    tools:text="Название передачи" />

                <TextView
                    android:id="@+id/tvNowOnAirBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/epg_badge_live_bg"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="в эфире"
                    android:textColor="#E74C3C"
                    android:textSize="10sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvArchiveBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/epg_badge_archive_bg"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="архив"
                    android:textColor="#4CAF50"
                    android:textSize="10sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvProgramDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/golos_text"
                android:textColor="#99FFFFFF"
                android:textSize="11sp"
                android:textFontWeight="400"
                android:maxLines="2"
                android:ellipsize="end"
                android:visibility="gone"
                tools:text="Описание передачи" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1AFFFFFF" />
</LinearLayout>
