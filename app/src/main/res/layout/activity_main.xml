            android:layout_marginTop="0dp"
            android:overScrollMode="ifContentScrolls"
            android:scrollbars="none"
            android:fillViewport="true"
            app:layout_constraintTop_toBottomOf="@id/tvHomeAppTitle"
            app:layout_constraintStart_toStartOf="@id/tvHomeAppTitle"
            app:layout_constraintEnd_toEndOf="@id/ivHomePower"
            app:layout_constraintBottom_toBottomOf="parent">

            <include layout="@layout/dialog_settings" />

        </ScrollView>



        <TextView
            android:id="@+id/tvHomeWelcome"
            style="@style/AppGolosText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/tvHomeAppTitle"
            app:layout_constraintTop_toBottomOf="@id/tvHomeAppTitle" />

        <TextView
            android:id="@+id/tvPlaylistPageTitle"
            style="@style/AppGolosText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="90dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="Доступные сервисы для просмотра"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/tvHomeAppTitle"
            app:layout_constraintEnd_toEndOf="@id/ivHomePower"
            app:layout_constraintTop_toBottomOf="@id/tvHomeAppTitle" />

        <TextView
            android:id="@+id/tvPlaylistPageSubtitle"
            style="@style/AppGolosText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="выберите один из сервисов для просмотра категорий каналов"
            android:textColor="#80FFFFFF"
            android:textSize="14sp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/tvHomeAppTitle"
            app:layout_constraintEnd_toEndOf="@id/ivHomePower"
            app:layout_constraintTop_toBottomOf="@id/tvPlaylistPageTitle" />

        <ScrollView
            android:id="@+id/homePlaylistTilesPanel"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:layout_marginTop="31dp"
            android:layout_marginStart="0dp"
            android:scrollbars="none"
            app:layout_constraintStart_toStartOf="@id/tvHomeAppTitle"
            app:layout_constraintEnd_toEndOf="@id/ivHomePower"
            app:layout_constraintTop_toBottomOf="@id/tvHomeAppTitle"
            app:layout_constraintBottom_toBottomOf="parent">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHomeTiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:clipToPadding="false"
                android:scrollbars="none"
                android:overScrollMode="never"/>
        </ScrollView>

        <GridView
