<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/videoLayout"
        app:use_controller="false"
        app:surface_type="texture_view"
        app:resize_mode="fit"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/tvReloadingStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_timer_warning_modal"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivReloadingIcon"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:src="@drawable/loader" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvReloadingTitle"
                android:layout_width="wrap_content"
                android:maxWidth="680dp"
                android:breakStrategy="high_quality"
                android:layout_height="wrap_content"
                android:text="Выполняется обновление трансляции! Ожидайте..."
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvReloadingSubtitle"
                android:layout_width="wrap_content"
                android:maxWidth="680dp"
                android:breakStrategy="high_quality"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textColor="#99FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvAppToast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_timer_warning_modal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:maxWidth="680dp"
        android:breakStrategy="high_quality"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/timerWarningPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_timer_warning_modal"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:src="@drawable/timer"
            android:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTimerWarning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Через несколько секунд произойдёт закрытие приложения!&#10;Для продолжения просмотра - остановите таймер"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Нажмите кнопку OK на пульте для остановки таймера"
                android:textColor="#99FFFFFF"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/btnStopTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
            android:layout_marginStart="0dp"
                android:background="@drawable/bg_settings_row"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="Остановить таймер"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/topGradientOverlay"
        android:layout_width="match_parent"
        android:layout_height="@dimen/player_top_gradient_height"
        android:background="@drawable/top_panel_bg"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/topInfoPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/player_top_min_height"
        android:layout_marginStart="@dimen/player_top_side_margin"
        android:layout_marginEnd="@dimen/player_top_side_margin"
        android:layout_marginTop="@dimen/player_top_margin"
        android:background="@android:color/transparent"
        android:orientation="horizontal"
        android:paddingStart="@dimen/player_top_inner_pad_h"
        android:paddingEnd="@dimen/player_top_inner_pad_h"
        android:paddingTop="@dimen/player_top_inner_pad_v"
        android:paddingBottom="@dimen/player_top_inner_pad_v"
        android:gravity="center_vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/btnBackToMenu"
            android:layout_width="@dimen/player_top_icon_size"
            android:layout_height="@dimen/player_top_icon_size"
            android:layout_gravity="center_vertical"
            android:src="@drawable/back"
            android:contentDescription="Back to menu" />

        <FrameLayout
            android:id="@+id/liveStatusBadge"
            android:layout_width="87dp"
            android:layout_height="40dp"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:clickable="false"
            android:layout_marginStart="@dimen/player_top_logo_margin_start"
            android:background="@drawable/bg_live_badge_red">

            <View
                android:id="@+id/liveStatusDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="14dp"
                android:background="@drawable/dot_live_red" />

            <TextView
                android:id="@+id/tvLiveStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/golos_text"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13sp"
                android:text="LIVE" />
        </FrameLayout>


        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/player_top_text_max_width"
            android:layout_marginStart="@dimen/player_top_text_margin_start"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tvChannelNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/golos_text"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/player_top_channel_text_size"
                    android:textStyle="bold"
                    tools:text="1." />
                <TextView
                    android:id="@+id/tvChannelNameInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/player_top_channel_name_gap"
                    android:fontFamily="@font/golos_text"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/player_top_channel_text_size"
                    android:textStyle="bold"
                    android:gravity="left"
                    tools:text="Название канала" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvEpgInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/player_top_epg_margin_top"
                android:fontFamily="@font/golos_text"
                android:textColor="#B3FFFFFF"
                android:textSize="@dimen/player_top_epg_text_size"
                android:gravity="left"
                tools:text="Загрузка программы..." />
        </LinearLayout>

        <LinearLayout
            android:layout_width="@dimen/player_time_width"
            android:layout_height="@dimen/player_time_height"
            android:layout_marginStart="@dimen/player_time_margin_start"
            android:background="@drawable/bg_player_time_rect"
            android:gravity="center"
            android:paddingHorizontal="@dimen/player_time_pad_h">
            <TextView
                android:id="@+id/tvSystemTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/golos_text"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/player_time_text_size"
                android:textStyle="bold"
                tools:text="17:10" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/controlsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp"
        android:background="@drawable/bottom_panel_bg"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/timelineArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tvCurrentTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/golos_text"
                    android:textStyle="bold"
                    android:textSize="14sp" />
                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />
                <TextView
                    android:id="@+id/tvProgramEndInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/golos_text"
                    android:textStyle="bold"
                    android:textSize="14sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/timelineTrack"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="8dp"
                android:clickable="true"
                android:focusable="false">
                <View
                    android:id="@+id/viewTimelineStripe"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:background="@drawable/player_timeline_stripe_bg" />
                <View
                    android:id="@+id/viewTimelineLive"
                    android:layout_width="0dp"
                    android:layout_height="8dp"
                    android:background="@drawable/player_timeline_live_bg" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnPlayPause"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_player_button_focus"
                android:defaultFocusHighlightEnabled="false"
                android:src="@drawable/pause"
                android:scaleType="fitCenter"
                android:focusable="true"
                android:clickable="true"
                android:padding="0dp" />

            <ImageButton
                android:id="@+id/btnBackLeft"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_player_button_focus"
                android:defaultFocusHighlightEnabled="false"
                android:src="@drawable/backleft"
                android:scaleType="fitCenter"
                android:focusable="true"
                android:clickable="true"
                android:padding="0dp" />

            <ImageButton
                android:id="@+id/btnBackRight"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_player_button_focus"
                android:defaultFocusHighlightEnabled="false"
                android:src="@drawable/backright"
                android:scaleType="fitCenter"
                android:focusable="true"
                android:clickable="true"
                android:padding="0dp" />

            <ImageButton
                android:id="@+id/btnLock"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_player_button_focus"
                android:defaultFocusHighlightEnabled="false"
                android:src="@drawable/block"
                android:scaleType="fitCenter"
                android:focusable="true"
                android:clickable="true"
                android:padding="0dp" />

            <ImageButton
                android:id="@+id/btnEpgPlayer"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_player_button_focus"
                android:defaultFocusHighlightEnabled="false"
                android:src="@drawable/epgplayer"
                android:scaleType="fitCenter"
                android:focusable="true"
                android:clickable="true"
                android:padding="0dp" />

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_player_button_focus"
                android:defaultFocusHighlightEnabled="false"
                android:src="@drawable/settingsplayer"
                android:scaleType="fitCenter"
                android:focusable="true"
                android:clickable="true"
                android:padding="0dp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnCcSubtitles"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:layout_width="48dp"
                android:layout_height="30dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_player_quality_badge"
                android:defaultFocusHighlightEnabled="false"
                android:fontFamily="@font/golos_text"
                android:gravity="center"
                android:text="CC"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnHdQuality"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:layout_width="48dp"
                android:layout_height="30dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_player_quality_badge"
                android:defaultFocusHighlightEnabled="false"
                android:fontFamily="@font/golos_text"
                android:gravity="center"
                android:text="HD"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/liveButtonContainer"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@android:color/transparent">

                <TextView
                    android:id="@+id/btnLiveReload"
                    android:layout_width="66dp"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_player_quality_badge"
                    android:defaultFocusHighlightEnabled="false"
                    android:fontFamily="@font/golos_text"
                    android:gravity="center"
                    android:text="LIVE"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:clickable="true" />
            </LinearLayout>
        </LinearLayout>

        <SeekBar
            android:id="@+id/sbTimeline"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:focusable="false"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/tvProgramEndTime"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnSleepTimer"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/epgPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/player_top_side_margin"
        android:layout_marginEnd="@dimen/player_top_side_margin"
        android:layout_marginTop="96dp"
        android:layout_marginBottom="96dp"
        android:orientation="vertical"
        android:background="@drawable/epg_panel_bg"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/epgDateRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btnEpgDatePrev"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:background="@drawable/player_btn_pill_bg"
                android:text="пред."
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:fontFamily="@font/golos_text"
                android:paddingHorizontal="14dp"
                android:focusable="true"
                android:clickable="true" />

            <HorizontalScrollView
                android:id="@+id/hsvEpgDates"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/epgDateContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/btnEpgDateNext"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:background="@drawable/player_btn_pill_bg"
                android:text="след."
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:fontFamily="@font/golos_text"
                android:paddingHorizontal="14dp"
                android:focusable="true"
                android:clickable="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvEpgEmptyState"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:fontFamily="@font/golos_text"
            android:textColor="#99FFFFFF"
            android:textSize="15sp"
            android:visibility="gone" />

        <ListView
            android:id="@+id/lvEpgPrograms"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:listSelector="@drawable/grid_item_selector"
            android:drawSelectorOnTop="true"
            android:scrollbars="none" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/channelListPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/player_top_side_margin"
        android:layout_marginEnd="@dimen/player_top_side_margin"
        android:layout_marginTop="96dp"
        android:layout_marginBottom="96dp"
        android:orientation="vertical"
        android:background="@drawable/epg_panel_bg"
        android:padding="16dp"
        android:visibility="gone">

        <GridView
            android:id="@+id/gvChannelListPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:numColumns="auto_fit"
            android:columnWidth="260dp"
            android:horizontalSpacing="12dp"
            android:verticalSpacing="12dp"
            android:stretchMode="columnWidth"
            android:gravity="start"
            android:listSelector="@drawable/grid_item_selector"
            android:drawSelectorOnTop="true"
            android:scrollbars="none" />
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/homePanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_home_screen"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvHomeAppTitle"
            style="@style/AppGolosText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="O.Portal"
            android:textColor="#FFFFFF"
            android:textFontWeight="1000"
            android:textSize="42sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.054"
            app:layout_constraintStart_toStartOf="@id/tvHomeAppTitle"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.055" />

        <TextView
            android:id="@+id/tvHomeBreadcrumbArrow"
            style="@style/AppGolosText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="&gt;"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/tvHomeAppTitle"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvHomeBreadcrumbPill"
            style="@style/AppGolosText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_breadcrumb_pill"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingHorizontal="12dp"
            android:paddingVertical="3dp"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/tvHomeAppTitle"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvHomeBreadcrumbArrow2"
            style="@style/AppGolosText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:includeFontPadding="false"
            android:text="&gt;"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:visibility="gone"
            app:layout_constraintStart_toEndOf="@id/tvHomeBreadcrumbPill"
            app:layout_constraintTop_toTopOf="@id/tvHomeBreadcrumbPill" />

        <TextView
            android:id="@+id/tvHomeBreadcrumbPill2"
            style="@style/AppGolosText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_breadcrumb_pill"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingHorizontal="12dp"
            android:paddingVertical="3dp"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:visibility="gone"
            app:layout_constraintStart_toEndOf="@id/tvHomeBreadcrumbArrow2"
            app:layout_constraintTop_toTopOf="@id/tvHomeBreadcrumbPill" />

        <TextView
            android:id="@+id/tvHomeSystemTime"
            style="@style/AppGolosText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textColor="#FFFFFF"
            android:textFontWeight="700"
            android:textSize="34sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.885"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.059"
            tools:text="21:00" />

        <ImageView
            android:id="@+id/ivHomePower"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_home_icon_selector"
            android:clickable="true"
            android:contentDescription="@string/home_power_button"
            android:focusable="false"
            android:scaleType="fitCenter"
            android:src="@drawable/fibspower"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.952"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.068" />

        <ImageView
