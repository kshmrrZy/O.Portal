<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/channelInfoPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_marginStart="48dp"
    android:layout_marginEnd="48dp"
    android:background="@drawable/bg_channel_info_panel"
    android:clickable="true"
    android:focusable="false"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="28dp"
    android:paddingEnd="28dp"
    android:paddingBottom="20dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivChannelInfoLogo"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_channel_logo_placeholder"
            android:contentDescription="@null"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_channel_logo_default"
            tools:ignore="ContentDescription" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvChannelInfoName"
                style="@style/AppGolosText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="Первый канал" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvChannelInfoService"
                    style="@style/AppGolosText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_channel_info_tag"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    tools:text="Wink" />

                <TextView
                    android:id="@+id/tvChannelInfoCategory"
                    style="@style/AppGolosText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_channel_info_tag"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    tools:text="федеральные" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        style="@style/AppGolosText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:includeFontPadding="false"
        android:text="Параметры трансляции"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvChannelInfoVideo"
        style="@style/AppGolosText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:includeFontPadding="false"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        tools:text="Видео: 1920 x 1080, 5,00 Мбит/с, 25.000 fps" />

    <TextView
        android:id="@+id/tvChannelInfoAudio"
        style="@style/AppGolosText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:includeFontPadding="false"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        tools:text="Аудио: AAC, 128 кбит/с" />

    <TextView
        android:id="@+id/btnChannelInfoBack"
        style="@style/AppGolosText"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_player_back_to_watch"
        android:clickable="true"
        android:defaultFocusHighlightEnabled="false"
        android:focusable="true"
        android:focusableInTouchMode="false"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="вернуться к просмотру"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />
</LinearLayout>
