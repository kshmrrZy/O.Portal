<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:padding="0dp">

    <TextView
        android:id="@+id/tvSettingsTitle"
        android:visibility="gone"
        style="@style/AppGolosText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Настройки"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvSettingsBack"
        style="@style/AppGolosText"
        android:elevation="12dp"
        android:translationZ="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="0dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="false"
        android:paddingHorizontal="1dp"
        android:paddingVertical="1dp"
        android:text="назад"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/userProfileHeaderCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:minHeight="110dp"
        android:background="@drawable/bg_profile_header_card"
        android:paddingHorizontal="18dp"
        android:paddingVertical="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/profileAvatarFrame"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_profile_avatar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:src="@drawable/profile"
                android:tint="#FFFFFF" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvProfileName"
            style="@style/AppGolosText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:text="Пользователь"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/profileAvatarFrame"
            app:layout_constraintTop_toTopOf="@id/profileAvatarFrame" />

        <TextView
            android:id="@+id/tvProfileNickname"
            style="@style/AppGolosText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@nickname"
            android:textColor="#80FFFFFF"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="@id/tvProfileName"
            app:layout_constraintTop_toBottomOf="@id/tvProfileName" />

        <TextView
            android:id="@+id/tvProfileTokenLabel"
            style="@style/AppGolosText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Токен:"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="@id/tvProfileName"
            app:layout_constraintTop_toBottomOf="@id/tvProfileNickname" />

        <TextView
            android:id="@+id/tvProfileTokenValue"
            style="@style/AppGolosText"
            android:layout_width="200dp"
            android:layout_height="22dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_settings_row"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="middle"
            android:paddingHorizontal="8dp"
            android:textColor="#80FFFFFF"
            android:textSize="10sp"
            app:layout_constraintStart_toEndOf="@id/tvProfileTokenLabel"
            app:layout_constraintTop_toTopOf="@id/tvProfileTokenLabel"
            app:layout_constraintBottom_toBottomOf="@id/tvProfileTokenLabel" />

        <ImageView
            android:id="@+id/btnProfileChangeToken"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="10dp"
            android:src="@drawable/ic_refresh_small"
            app:layout_constraintStart_toEndOf="@id/tvProfileTokenValue"
            app:layout_constraintTop_toTopOf="@id/tvProfileTokenValue"
            app:layout_constraintBottom_toBottomOf="@id/tvProfileTokenValue" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/btnPlaylistSettings" android:focusable="true" android:focusableInTouchMode="false"
        android:layout_width="0dp"
        android:layout_height="66dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_settings_grid_card"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toStartOf="@id/settingsGridGuide1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/userProfileHeaderCard">

        <TextView
            style="@style/AppGolosText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Настройки плейлистов"
            android:textColor="#FFFFFF"
            android:textFontWeight="500"
            android:textSize="18sp" />
    </LinearLayout>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/settingsGridGuide1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.335" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/settingsGridGuide2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.665" />

    <LinearLayout
        android:id="@+id/btnEpgSelect" android:focusable="true" android:focusableInTouchMode="false"
        android:layout_width="0dp"
        android:layout_height="66dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_settings_grid_card"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="@id/settingsGridGuide1"
        app:layout_constraintEnd_toStartOf="@id/settingsGridGuide2"
        app:layout_constraintTop_toBottomOf="@id/userProfileHeaderCard">

        <TextView style="@style/AppGolosText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:text="Настройки EPG" android:textColor="#FFFFFF" android:textFontWeight="500" android:textSize="18sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnSleepTimerSettings" android:focusable="true" android:focusableInTouchMode="false"
        android:layout_width="0dp" android:layout_height="66dp" android:layout_marginTop="12dp"
        android:background="@drawable/bg_settings_grid_card" android:gravity="center" android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/userProfileHeaderCard" app:layout_constraintStart_toStartOf="@id/settingsGridGuide2" app:layout_constraintEnd_toEndOf="parent">
        <TextView style="@style/AppGolosText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:text="Настройки таймера" android:textColor="#FFFFFF" android:textFontWeight="500" android:textSize="18sp"/>
        <TextView
            android:id="@+id/tvSleepTimerValue"
            style="@style/AppGolosText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="выключено"
            android:textColor="#99FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnUserSettings" android:focusable="true" android:focusableInTouchMode="false"
        android:layout_width="0dp" android:layout_height="66dp" android:layout_marginTop="12dp"
        android:background="@drawable/bg_settings_grid_card" android:gravity="center" android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/btnPlaylistSettings" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@id/settingsGridGuide1">
        <TextView style="@style/AppGolosText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:text="Настройки профиля" android:textColor="#FFFFFF" android:textFontWeight="500" android:textSize="18sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnAdvancedSettings" android:focusable="true" android:focusableInTouchMode="false"
        android:layout_width="0dp" android:layout_height="66dp" android:layout_marginTop="12dp"
        android:background="@drawable/bg_settings_grid_card" android:gravity="center" android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/btnEpgSelect" app:layout_constraintStart_toStartOf="@id/settingsGridGuide1" app:layout_constraintEnd_toStartOf="@id/settingsGridGuide2">
        <TextView style="@style/AppGolosText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:text="Экспорт лога" android:textColor="#FFFFFF" android:textFontWeight="500" android:textSize="18sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnAppInfo" android:focusable="true" android:focusableInTouchMode="false"
        android:layout_width="0dp" android:layout_height="66dp" android:layout_marginTop="12dp"
        android:background="@drawable/bg_settings_grid_card" android:gravity="center" android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/btnSleepTimerSettings" app:layout_constraintStart_toStartOf="@id/settingsGridGuide2" app:layout_constraintEnd_toEndOf="parent">
        <TextView style="@style/AppGolosText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:text="О приложении" android:textColor="#FFFFFF" android:textFontWeight="500" android:textSize="18sp"/>
    </LinearLayout>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/settingsGridGuideHalf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <LinearLayout
        android:id="@+id/btnResetSettings" android:focusable="true" android:focusableInTouchMode="false"
        android:layout_width="0dp" android:layout_height="52dp" android:layout_marginTop="14dp"
        android:background="@drawable/bg_settings_danger_card" android:gravity="center" android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/btnUserSettings" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@id/settingsGridGuideHalf">
        <TextView style="@style/AppGolosText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:text="Сбросить настройки" android:textColor="#EF4444" android:textFontWeight="500" android:textSize="16sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnLogoutProfile" android:focusable="true" android:focusableInTouchMode="false"
        android:layout_width="0dp" android:layout_height="52dp" android:layout_marginTop="14dp"
        android:background="@drawable/bg_settings_danger_card" android:gravity="center" android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/btnUserSettings" app:layout_constraintStart_toStartOf="@id/settingsGridGuideHalf" app:layout_constraintEnd_toEndOf="parent">
        <TextView style="@style/AppGolosText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:text="Выйти из профиля" android:textColor="#EF4444" android:textFontWeight="500" android:textSize="16sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnExportDebugLog" android:focusable="true" android:focusableInTouchMode="false"
        android:layout_width="0dp" android:layout_height="0dp"
        android:background="@drawable/bg_settings_grid_card" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/btnUserSettings" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/folder" android:tint="#FFFFFF"/>
        <TextView style="@style/AppGolosText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:text="Экспорт debug лога" android:textColor="#FFFFFF" android:textFontWeight="500" android:textSize="14sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/playlistSettingsPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="32dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView style="@style/AppGolosText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Раздел для настройки плейлистов" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold"/>
        <TextView style="@style/AppGolosText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="поддерживается не более 3 источников формата M3U/M3U8" android:textColor="#99FFFFFF" android:textSize="12sp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center_vertical" android:orientation="horizontal">
            <EditText android:id="@+id/etPlaylistUrl1" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:background="@drawable/bg_epg_url_field" android:hint="введите URL" android:paddingHorizontal="12dp" android:textColor="#FFFFFF" android:textColorHint="#80FFFFFF" android:textSize="12sp"/>
            <FrameLayout android:id="@+id/ivPlaylistToggle1" android:focusable="true" android:focusableInTouchMode="false" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginStart="8dp" android:background="@drawable/bg_epg_url_field">
                <View android:id="@+id/dotPlaylistActive1" android:layout_width="10dp" android:layout_height="10dp" android:layout_gravity="center" android:background="@drawable/bg_playlist_active_dot" android:visibility="visible"/>
            </FrameLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
            <EditText android:id="@+id/etPlaylistUrl2" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:background="@drawable/bg_epg_url_field" android:hint="введите URL" android:paddingHorizontal="12dp" android:textColor="#FFFFFF" android:textColorHint="#80FFFFFF" android:textSize="12sp"/>
            <FrameLayout android:id="@+id/ivPlaylistToggle2" android:focusable="true" android:focusableInTouchMode="false" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginStart="8dp" android:background="@drawable/bg_epg_url_field">
                <View android:id="@+id/dotPlaylistActive2" android:layout_width="10dp" android:layout_height="10dp" android:layout_gravity="center" android:background="@drawable/bg_playlist_active_dot" android:visibility="gone"/>
            </FrameLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
            <EditText android:id="@+id/etPlaylistUrl3" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:background="@drawable/bg_epg_url_field" android:hint="введите URL" android:paddingHorizontal="12dp" android:textColor="#FFFFFF" android:textColorHint="#80FFFFFF" android:textSize="12sp"/>
            <FrameLayout android:id="@+id/ivPlaylistToggle3" android:focusable="true" android:focusableInTouchMode="false" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginStart="8dp" android:background="@drawable/bg_epg_url_field">
                <View android:id="@+id/dotPlaylistActive3" android:layout_width="10dp" android:layout_height="10dp" android:layout_gravity="center" android:background="@drawable/bg_playlist_active_dot" android:visibility="gone"/>
            </FrameLayout>
        </LinearLayout>

        <EditText android:id="@+id/etPlaylistName1" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
        <EditText android:id="@+id/etPlaylistName2" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
        <EditText android:id="@+id/etPlaylistName3" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="8dp" android:orientation="vertical"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/btnSavePlaylistSettings" android:focusable="true" android:focusableInTouchMode="false" style="@style/AppGolosText" android:layout_width="0dp" android:layout_height="66dp" android:layout_weight="1" android:background="@drawable/bg_settings_action_green" android:gravity="center" android:text="Сохранить настройки" android:textColor="#FFFFFF" android:textFontWeight="500" android:textSize="18sp"/>
            <TextView android:id="@+id/btnRefreshPlaylistSettings" android:focusable="true" android:focusableInTouchMode="false" style="@style/AppGolosText" android:layout_width="0dp" android:layout_height="66dp" android:layout_weight="1" android:layout_marginStart="10dp" android:background="@drawable/bg_settings_action_red" android:gravity="center" android:text="Назад" android:textColor="#FFFFFF" android:textFontWeight="500" android:textSize="18sp"/>
        </LinearLayout>
    </LinearLayout>

    

    <LinearLayout
        android:id="@+id/epgSettingsPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="39dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView style="@style/AppGolosText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Раздел для настройки EPG" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold"/>
        <TextView android:id="@+id/tvEpgScreenSubtitle" style="@style/AppGolosText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="поддерживается не более 3 источников формата XML" android:textColor="#99FFFFFF" android:textSize="12sp"/>
        <TextView android:id="@+id/tvEpgSourceHint" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>

        <EditText android:id="@+id/etEpgUrl1" android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="16dp" android:background="@drawable/bg_epg_url_field" android:hint="введите URL" android:paddingHorizontal="12dp" android:textColor="#FFFFFF" android:textColorHint="#80FFFFFF" android:textSize="12sp"/>
        <EditText android:id="@+id/etEpgUrl2" android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="8dp" android:background="@drawable/bg_epg_url_field" android:hint="введите URL" android:paddingHorizontal="12dp" android:textColor="#FFFFFF" android:textColorHint="#80FFFFFF" android:textSize="12sp"/>
        <EditText android:id="@+id/etEpgUrl3" android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="8dp" android:background="@drawable/bg_epg_url_field" android:hint="введите URL" android:paddingHorizontal="12dp" android:textColor="#FFFFFF" android:textColorHint="#80FFFFFF" android:textSize="12sp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="8dp" android:orientation="vertical"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <ImageView android:id="@+id/ivEpgToggle1" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" android:src="@drawable/toggleright"/>
            <ImageView android:id="@+id/ivEpgToggle2" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" android:src="@drawable/toggleright"/>
            <ImageView android:id="@+id/ivEpgToggle3" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" android:src="@drawable/toggleright"/>
            <ToggleButton android:id="@+id/tbEpgRefreshInterval" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" android:textOff="1 день" android:textOn="1 день"/>

            <TextView
                android:id="@+id/btnResetEpgCache" android:focusable="true" android:focusableInTouchMode="false"
                style="@style/AppGolosText" android:layout_width="0dp" android:layout_height="66dp" android:layout_weight="1"
                android:background="@drawable/bg_settings_grid_card" android:gravity="center" android:text="Сбросить кэш EPG" android:textColor="#FFFFFF" android:textFontWeight="500" android:textSize="18sp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
            <ToggleButton android:id="@+id/tbEpgSourceMode" android:focusable="true" android:focusableInTouchMode="false" android:layout_width="0dp" android:layout_height="66dp" android:layout_weight="1" android:background="@drawable/bg_settings_grid_card" android:textAllCaps="false" android:textColor="#FFFFFF" android:textOff="Использовать свои источники" android:textOn="Использовать встроенные источники" android:textSize="18sp"/>
            <TextView android:id="@+id/btnSaveEpgSettings" android:focusable="true" android:focusableInTouchMode="false" style="@style/AppGolosText" android:layout_width="0dp" android:layout_height="66dp" android:layout_weight="1" android:layout_marginStart="10dp" android:background="@drawable/bg_settings_action_green" android:gravity="center" android:text="Сохранить настройки" android:textColor="#FFFFFF" android:textFontWeight="500" android:textSize="18sp"/>
            <TextView android:id="@+id/btnRefreshEpgSettings" android:focusable="true" android:focusableInTouchMode="false" style="@style/AppGolosText" android:layout_width="0dp" android:layout_height="66dp" android:layout_weight="1" android:layout_marginStart="10dp" android:background="@drawable/bg_settings_action_red" android:gravity="center" android:text="Назад" android:textColor="#FFFFFF" android:textFontWeight="500" android:textSize="18sp"/>
        </LinearLayout>
    </LinearLayout>
<ScrollView
        android:id="@+id/appInfoPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="39dp"
        android:fillViewport="true"
        android:scrollbars="none"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView style="@style/AppGolosText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Описание" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold"/>
            <TextView style="@style/AppGolosText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Приложение предназначено для просмотра IPTV-каналов с портала O.Portal" android:textColor="#CCFFFFFF" android:textSize="16sp"/>

            <TextView style="@style/AppGolosText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Рекомендуемые параметры" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold"/>
            <TextView style="@style/AppGolosText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Операционная система не ниже Android 7.0, не менее 1 ГБ ОЗУ, не менее 500 МБ для установки" android:textColor="#CCFFFFFF" android:textSize="16sp"/>

            <TextView style="@style/AppGolosText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Где взять логин и токен" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold"/>
