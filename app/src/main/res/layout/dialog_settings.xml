            <TextView android:id="@+id/btnUserAuthInline" android:focusable="true" android:focusableInTouchMode="false" style="@style/AppGolosText" android:layout_width="140dp" android:layout_height="43dp" android:layout_gravity="end" android:layout_marginTop="20dp" android:background="@drawable/bg_login_field" android:gravity="center" android:text="Войти" android:textColor="#FFFFFF" android:textFontWeight="500" android:textSize="20sp"/>
