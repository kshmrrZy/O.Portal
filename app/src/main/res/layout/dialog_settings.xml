<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_glass_panel">

    <TextView
        android:id="@+id/tvSettingsSectionTitle"
        style="@style/AppGolosText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="61dp"
        android:layout_marginTop="80dp"
        android:text="Настройки"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView android:id="@+id/btnPlaylistSettings" style="@style/SettingsCard" android:layout_marginStart="61dp" android:layout_marginTop="124dp" android:text="Настроить плейлисты" android:drawableStart="@drawable/list" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
    <TextView android:id="@+id/btnEpgSelect" style="@style/SettingsCard" android:layout_marginStart="61dp" android:layout_marginTop="219dp" android:text="Настройка программы передач (EPG)" android:drawableStart="@drawable/epg" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
    <TextView android:id="@+id/btnSleepTimerSettings" style="@style/SettingsCard" android:layout_marginStart="61dp" android:layout_marginTop="313dp" android:text="Таймер сна" android:drawableStart="@drawable/timer" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>

    <LinearLayout
        android:id="@+id/rowStartMode"
        style="@style/SettingsCard"
        android:layout_marginStart="61dp"
        android:layout_marginTop="408dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/folder"/>
        <TextView style="@style/AppGolosText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:text="Выбор страницы при открытии приложения" android:textColor="#FFFFFF" android:textSize="16sp"/>
        <ToggleButton android:id="@+id/tbStartMode" android:layout_width="wrap_content" android:layout_height="36dp" android:textOn="Последний канал" android:textOff="Стартовая страница" android:textAllCaps="false" android:minWidth="180dp"/>
    </LinearLayout>

    <TextView android:id="@+id/btnExtraSettings" style="@style/SettingsCard" android:layout_marginStart="61dp" android:layout_marginTop="503dp" android:text="Дополнительные настройки" android:drawableStart="@drawable/settings" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
    <TextView android:id="@+id/btnUserSettings" style="@style/SettingsCard" android:layout_marginStart="62dp" android:layout_marginTop="598dp" android:text="Настроить пользователя" android:drawableStart="@drawable/profile" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/btnCloseSettingsDialog"
        style="@style/WhiteTitleTextShadow"
        android:layout_width="220dp"
        android:layout_height="44dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_watch_button"
        android:gravity="center"
        android:text="Закрыть"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
