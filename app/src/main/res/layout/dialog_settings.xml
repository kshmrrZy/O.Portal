<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:padding="0dp">

    <TextView
        android:id="@+id/tvSettingsTitle"
        android:visibility="gone"
        style="@style/AppGolosText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Настройки"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvSettingsBack"
        style="@style/AppGolosText"
        android:elevation="12dp"
        android:translationZ="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="0dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="false"
        android:paddingHorizontal="1dp"
        android:paddingVertical="1dp"
        android:text="назад"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/btnPlaylistSettings" android:focusable="true" android:focusableInTouchMode="false"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_settings_row"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSettingsBack">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/list"
            android:tint="#FFFFFF" />

        <TextView
            style="@style/AppGolosText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="Настроить плейлисты"
            android:textColor="#FFFFFF"
            android:textFontWeight="500"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnEpgSelect" android:focusable="true" android:focusableInTouchMode="false"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_settings_row"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnPlaylistSettings">

        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/epg" android:tint="#FFFFFF"/>
        <TextView style="@style/AppGolosText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:text="Настройка программы передач (EPG)" android:textColor="#FFFFFF" android:textFontWeight="500" android:textSize="14sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnSleepTimerSettings" android:focusable="true" android:focusableInTouchMode="false"
        android:layout_width="0dp" android:layout_height="46dp" android:layout_marginTop="8dp"
        android:background="@drawable/bg_settings_row" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp"
        app:layout_constraintTop_toBottomOf="@id/btnEpgSelect" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/timer" android:tint="#FFFFFF"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView android:id="@+id/tvSleepTimerTitle" style="@style/AppGolosText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Таймер сна" android:textColor="#FFFFFF" android:textFontWeight="500" android:textSize="14sp"/>
            <TextView
                android:id="@+id/tvSleepTimerHint"
                style="@style/AppGolosText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Телефон: нажимайте на пункт для смены значения • Пульт: нажимайте ОК для смены значения"
                android:textColor="#99FFFFFF"
                android:textSize="6sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/tvSleepTimerValue"
                style="@style/AppGolosText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="выключено"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="10dp">
                <TextView
                    android:id="@+id/btnSleepUp"
                    android:layout_width="26dp"
                    android:layout_height="18dp"
                    android:gravity="center"
                    android:text="▲"
                    android:textColor="#FFFFFF" />
                <TextView
                    android:id="@+id/btnSleepDown"
                    android:layout_width="26dp"
                    android:layout_height="18dp"
                    android:gravity="center"
                    android:text="▼"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/itemStartMode" android:focusable="true" android:focusableInTouchMode="false"
        android:layout_width="0dp" android:layout_height="46dp" android:layout_marginTop="8dp"
        android:background="@drawable/bg_settings_row" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp"
        app:layout_constraintTop_toBottomOf="@id/btnSleepTimerSettings" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/folder" android:tint="#FFFFFF"/>
        <TextView style="@style/AppGolosText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:text="Выбор страницы при открытии приложения" android:textColor="#FFFFFF" android:textFontWeight="500" android:textSize="14sp"/>
        <ToggleButton
            android:id="@+id/tbStartMode"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:minWidth="190dp"
            android:background="@drawable/bg_settings_row"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textOff="Стартовая страница"
            android:textOn="Последний канал"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/itemAspectRatio" android:focusable="true" android:focusableInTouchMode="false"
        android:layout_width="0dp" android:layout_height="46dp" android:layout_marginTop="8dp"
        android:background="@drawable/bg_settings_row" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp"
        app:layout_constraintTop_toBottomOf="@id/itemStartMode" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/folder" android:tint="#FFFFFF"/>
        <TextView style="@style/AppGolosText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:text="Соотношение сторон видео" android:textColor="#FFFFFF" android:textFontWeight="500" android:textSize="14sp"/>
        <ToggleButton
            android:id="@+id/tbAspectRatio"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:minWidth="190dp"
            android:background="@drawable/bg_settings_row"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textOff="Автоматически"
            android:textOn="Автоматически"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnAdvancedSettings" android:focusable="true" android:focusableInTouchMode="false"
        android:layout_width="0dp" android:layout_height="46dp" android:layout_marginTop="8dp"
        android:background="@drawable/bg_settings_row" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp"
        app:layout_constraintTop_toBottomOf="@id/itemAspectRatio" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/settings" android:tint="#FFFFFF"/>
        <TextView style="@style/AppGolosText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:text="Экспорт лога" android:textColor="#FFFFFF" android:textFontWeight="500" android:textSize="14sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnUserSettings" android:focusable="true" android:focusableInTouchMode="false"
        android:layout_width="0dp" android:layout_height="46dp" android:layout_marginTop="8dp"
        android:background="@drawable/bg_settings_row" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp"
        app:layout_constraintTop_toBottomOf="@id/btnAdvancedSettings" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/profile" android:tint="#FFFFFF"/>
        <TextView style="@style/AppGolosText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:text="Настроить пользователя" android:textColor="#FFFFFF" android:textFontWeight="500" android:textSize="14sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnExportDebugLog" android:focusable="true" android:focusableInTouchMode="false"
        android:layout_width="0dp" android:layout_height="46dp" android:layout_marginTop="8dp"
        android:background="@drawable/bg_settings_row" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp"
        app:layout_constraintTop_toBottomOf="@id/btnUserSettings" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/folder" android:tint="#FFFFFF"/>
        <TextView style="@style/AppGolosText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:text="Экспорт debug лога" android:textColor="#FFFFFF" android:textFontWeight="500" android:textSize="14sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnAppInfo" android:focusable="true" android:focusableInTouchMode="false"
        android:layout_width="0dp" android:layout_height="46dp" android:layout_marginTop="8dp"
        android:background="@drawable/bg_settings_row" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp"
        app:layout_constraintTop_toBottomOf="@id/btnExportDebugLog" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/alert" android:tint="#FFFFFF"/>
        <TextView style="@style/AppGolosText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:text="Информация о приложении" android:textColor="#FFFFFF" android:textFontWeight="500" android:textSize="14sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/playlistSettingsPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="32dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            style="@style/AppGolosText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Сторонние плейлисты"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <EditText android:id="@+id/etPlaylistName1" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="0.33" android:background="@drawable/bg_settings_row" android:hint="название плейлиста" android:paddingHorizontal="12dp" android:textColor="#FFFFFF" android:textColorHint="#66FFFFFF" android:textSize="16sp"/>
            <EditText android:id="@+id/etPlaylistUrl1" android:layout_width="0dp" android:layout_height="40dp" android:layout_marginStart="8dp" android:layout_weight="0.67" android:background="@drawable/bg_settings_row" android:hint="введите ссылку на плейлист вида https://example.com/playlist.m3u8" android:paddingHorizontal="12dp" android:textColor="#FFFFFF" android:textColorHint="#66FFFFFF" android:textSize="16sp"/>
            <ImageView android:id="@+id/ivPlaylistToggle1" android:layout_width="48dp" android:layout_height="28dp" android:layout_marginStart="8dp" android:src="@drawable/toggleright"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <EditText android:id="@+id/etPlaylistName2" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="0.33" android:background="@drawable/bg_settings_row" android:hint="название плейлиста" android:paddingHorizontal="12dp" android:textColor="#FFFFFF" android:textColorHint="#66FFFFFF" android:textSize="16sp"/>
            <EditText android:id="@+id/etPlaylistUrl2" android:layout_width="0dp" android:layout_height="40dp" android:layout_marginStart="8dp" android:layout_weight="0.67" android:background="@drawable/bg_settings_row" android:hint="введите ссылку на плейлист вида https://example.com/playlist.m3u8" android:paddingHorizontal="12dp" android:textColor="#FFFFFF" android:textColorHint="#66FFFFFF" android:textSize="16sp"/>
            <ImageView android:id="@+id/ivPlaylistToggle2" android:layout_width="48dp" android:layout_height="28dp" android:layout_marginStart="8dp" android:src="@drawable/toggleright"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <EditText android:id="@+id/etPlaylistName3" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="0.33" android:background="@drawable/bg_settings_row" android:hint="название плейлиста" android:paddingHorizontal="12dp" android:textColor="#FFFFFF" android:textColorHint="#66FFFFFF" android:textSize="16sp"/>
            <EditText android:id="@+id/etPlaylistUrl3" android:layout_width="0dp" android:layout_height="40dp" android:layout_marginStart="8dp" android:layout_weight="0.67" android:background="@drawable/bg_settings_row" android:hint="введите ссылку на плейлист вида https://example.com/playlist.m3u8" android:paddingHorizontal="12dp" android:textColor="#FFFFFF" android:textColorHint="#66FFFFFF" android:textSize="16sp"/>
            <ImageView android:id="@+id/ivPlaylistToggle3" android:layout_width="48dp" android:layout_height="28dp" android:layout_marginStart="8dp" android:src="@drawable/toggleright"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:gravity="end">
            <TextView android:id="@+id/btnSavePlaylistSettings" android:focusable="true" android:focusableInTouchMode="false" style="@style/AppGolosText" android:layout_width="160dp" android:layout_height="42dp" android:background="@drawable/bg_settings_row" android:gravity="center" android:text="Сохранить" android:textColor="#FFFFFF" android:textSize="16sp"/>
            <TextView android:id="@+id/btnRefreshPlaylistSettings" android:focusable="true" android:focusableInTouchMode="false" style="@style/AppGolosText" android:layout_width="160dp" android:layout_height="42dp" android:layout_marginStart="10dp" android:background="@drawable/bg_settings_row" android:gravity="center" android:text="Обновить" android:textColor="#FFFFFF" android:textSize="16sp"/>
        </LinearLayout>

        <TextView
            style="@style/AppGolosText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="На текущий момент можно добавить до 3 плейлистов, поддерживаются форматы M3U/M3U8"
            android:textColor="#B3FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    

    <LinearLayout
        android:id="@+id/epgSettingsPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="39dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView style="@style/AppGolosText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Источник EPG" android:textColor="#FFFFFF" android:textSize="14sp"/>
            <ToggleButton android:id="@+id/tbEpgSourceMode" android:focusable="true" android:focusableInTouchMode="false" android:layout_width="wrap_content" android:layout_height="30dp" android:minWidth="190dp" android:background="@drawable/bg_settings_row" android:textAllCaps="false" android:textColor="#FFFFFF" android:textOff="Из плейлиста" android:textOn="Указать вручную" android:textSize="12sp"/>
        </LinearLayout>
        <TextView android:id="@+id/tvEpgSourceHint" style="@style/AppGolosText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="" android:textColor="#99FFFFFF" android:textSize="12sp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/ivEpgToggle1" android:layout_width="48dp" android:layout_height="28dp" android:src="@drawable/toggleright"/>
            <EditText android:id="@+id/etEpgUrl1" android:layout_width="0dp" android:layout_height="40dp" android:layout_marginStart="8dp" android:layout_weight="1" android:background="@drawable/bg_settings_row" android:hint="введите ссылку EPG" android:paddingHorizontal="12dp" android:textColor="#FFFFFF" android:textColorHint="#66FFFFFF" android:textSize="16sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/ivEpgToggle2" android:layout_width="48dp" android:layout_height="28dp" android:src="@drawable/toggleright"/>
            <EditText android:id="@+id/etEpgUrl2" android:layout_width="0dp" android:layout_height="40dp" android:layout_marginStart="8dp" android:layout_weight="1" android:background="@drawable/bg_settings_row" android:hint="введите ссылку EPG" android:paddingHorizontal="12dp" android:textColor="#FFFFFF" android:textColorHint="#66FFFFFF" android:textSize="16sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/ivEpgToggle3" android:layout_width="48dp" android:layout_height="28dp" android:src="@drawable/toggleright"/>
            <EditText android:id="@+id/etEpgUrl3" android:layout_width="0dp" android:layout_height="40dp" android:layout_marginStart="8dp" android:layout_weight="1" android:background="@drawable/bg_settings_row" android:hint="введите ссылку EPG" android:paddingHorizontal="12dp" android:textColor="#FFFFFF" android:textColorHint="#66FFFFFF" android:textSize="16sp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView style="@style/AppGolosText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Интервал обновления" android:textColor="#FFFFFF" android:textSize="14sp"/>
            <ToggleButton android:id="@+id/tbEpgRefreshInterval" android:focusable="true" android:focusableInTouchMode="false" android:layout_width="wrap_content" android:layout_height="30dp" android:minWidth="150dp" android:background="@drawable/bg_settings_row" android:textAllCaps="false" android:textColor="#FFFFFF" android:textOff="1 день" android:textOn="1 день" android:textSize="12sp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:gravity="end">
            <TextView android:id="@+id/btnSaveEpgSettings" android:focusable="true" android:focusableInTouchMode="false" style="@style/AppGolosText" android:layout_width="160dp" android:layout_height="42dp" android:background="@drawable/bg_settings_row" android:gravity="center" android:text="Сохранить" android:textColor="#FFFFFF" android:textSize="16sp"/>
            <TextView android:id="@+id/btnRefreshEpgSettings" android:focusable="true" android:focusableInTouchMode="false" style="@style/AppGolosText" android:layout_width="160dp" android:layout_height="42dp" android:layout_marginStart="10dp" android:background="@drawable/bg_settings_row" android:gravity="center" android:text="Обновить" android:textColor="#FFFFFF" android:textSize="16sp"/>
        </LinearLayout>
    </LinearLayout>
<ScrollView
        android:id="@+id/appInfoPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="39dp"
        android:fillViewport="true"
        android:scrollbars="none"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView style="@style/AppGolosText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Описание" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
            <TextView style="@style/AppGolosText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Приложение предназначено для просмотра IPTV-каналов с портала O.Portal" android:textColor="#CCFFFFFF" android:textSize="14sp"/>

            <TextView style="@style/AppGolosText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Рекомендуемые параметры" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
            <TextView style="@style/AppGolosText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Операционная система не ниже Android 7.0, не менее 1 ГБ ОЗУ, не менее 500 МБ для установки" android:textColor="#CCFFFFFF" android:textSize="14sp"/>

            <TextView style="@style/AppGolosText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Где взять логин и токен" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
            <TextView style="@style/AppGolosText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="На сайте o.avff.pw в разделе Профиль после авторизации с помощью VK или Telegram" android:textColor="#CCFFFFFF" android:textSize="14sp"/>

            <TextView style="@style/AppGolosText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Где проверить обновление приложения" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
            <TextView style="@style/AppGolosText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="По технической возможности направляем OTA-уведомление для скачивания, но новую версию можно скачать по ссылке o.avff.pw/app" android:textColor="#CCFFFFFF" android:textSize="14sp"/>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="18dp" android:background="#33FFFFFF"/>

            <TextView style="@style/AppGolosText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="1. Назначение приложения" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
            <TextView style="@style/AppGolosText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Приложение O.Portal представляет собой программный проигрыватель (плеер), предназначенный для воспроизведения медиаплейлистов в формате IPTV (M3U/M3U8 и аналогичных), которые пользователь самостоятельно добавляет по ссылкам, полученным из сети Интернет. Приложение не хранит, не размещает, не распространяет и не индексирует какой-либо медиаконтент, а также не предоставляет собственных каналов, плейлистов или трансляций." android:textColor="#CCFFFFFF" android:textSize="14sp"/>

            <TextView style="@style/AppGolosText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="2. Источник контента" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
            <TextView style="@style/AppGolosText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Все плейлисты и ссылки на потоковые трансляции добавляются пользователем самостоятельно. Разработчик приложения не имеет отношения к созданию, размещению или поддержке источников контента, на которые ссылаются добавленные пользователем плейлисты, и не осуществляет предварительную проверку, модерацию или контроль содержимого таких источников." android:textColor="#CCFFFFFF" android:textSize="14sp"/>

            <TextView style="@style/AppGolosText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="3. Ограничение ответственности" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
            <TextView style="@style/AppGolosText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Разработчик приложения не несёт ответственности за:\n• содержание, легальность и происхождение контента, доступного по добавленным пользователем ссылкам;\n• цели, для которых пользователь использует приложение;\n• возможные нарушения авторских и смежных прав, допущенные при использовании сторонних источников контента.\n\nПриложение является технологическим инструментом (плеером) и не осуществляет и не может осуществлять контроль над тем, какие именно ссылки добавляет пользователь и какой контент по ним доступен." android:textColor="#CCFFFFFF" android:textSize="14sp"/>

            <TextView style="@style/AppGolosText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="4. Отсутствие технической возможности контроля" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
            <TextView style="@style/AppGolosText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="В силу технической архитектуры приложения (пользователь самостоятельно вводит внешние ссылки на потоки) у разработчика отсутствует техническая возможность проверять правовой статус контента, транслируемого по указанным пользователем источникам, до момента его воспроизведения." android:textColor="#CCFFFFFF" android:textSize="14sp"/>

            <TextView style="@style/AppGolosText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="5. Обязанности пользователя" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
            <TextView style="@style/AppGolosText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Используя приложение, пользователь подтверждает, что:\n• самостоятельно несёт ответственность за выбор источников контента и соблюдение применимого законодательства, включая законодательство об авторском праве;\n• обязуется не использовать приложение для доступа к контенту, распространяемому с нарушением прав правообладателей;\n• использует приложение на свой риск." android:textColor="#CCFFFFFF" android:textSize="14sp"/>

            <TextView style="@style/AppGolosText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="6. Обращения правообладателей" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
            <TextView style="@style/AppGolosText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Если вы являетесь правообладателем и полагаете, что функционирование приложения каким-либо образом затрагивает ваши права, вы можете связаться с разработчиками приложения через Telegram: t.me/oportal_bot. Разработчик готов оперативно рассматривать поступившие обращения и, при наличии технической возможности, предпринимать разумные меры реагирования, несмотря на то что сам разработчик не размещает и не контролирует контент, доступный по ссылкам, добавленным пользователями." android:textColor="#CCFFFFFF" android:textSize="14sp"/>

            <TextView android:id="@+id/tvAppInfoDevelopers" style="@style/AppGolosText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Developments: TwojNochnojKoshmar, avtnmis" android:textColor="#99FFFFFF" android:textSize="12sp"/>
            <TextView android:id="@+id/tvAppInfoFeedback" style="@style/AppGolosText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Feedback: t.me/@oportal_bot" android:textColor="#99FFFFFF" android:textSize="12sp"/>

