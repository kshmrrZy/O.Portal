<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:padding="0dp">

    <TextView
        android:id="@+id/tvSettingsTitle"
        android:visibility="gone"
        style="@style/AppGolosText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Настройки"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvSettingsBack"
        style="@style/AppGolosText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="28dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:text="назад"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/btnPlaylistSettings"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_settings_row"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSettingsBack">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/list"
            android:tint="#FFFFFF" />

        <TextView
            style="@style/AppGolosText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="Настроить плейлисты"
            android:textColor="#FFFFFF"
            android:textFontWeight="500"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnEpgSelect"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_settings_row"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnPlaylistSettings">

        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/epg" android:tint="#FFFFFF"/>
        <TextView style="@style/AppGolosText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:text="Настройка программы передач (EPG)" android:textColor="#FFFFFF" android:textFontWeight="500" android:textSize="14sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnSleepTimerSettings"
        android:layout_width="0dp" android:layout_height="46dp" android:layout_marginTop="8dp"
        android:background="@drawable/bg_settings_row" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp"
        app:layout_constraintTop_toBottomOf="@id/btnEpgSelect" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/timer" android:tint="#FFFFFF"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView android:id="@+id/tvSleepTimerTitle" style="@style/AppGolosText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Таймер сна" android:textColor="#FFFFFF" android:textFontWeight="500" android:textSize="14sp"/>
            <TextView
                android:id="@+id/tvSleepTimerHint"
                style="@style/AppGolosText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Телефон: нажимайте на пункт для смены значения • Пульт: нажимайте ОК для смены значения"
                android:textColor="#99FFFFFF"
                android:textSize="6sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/tvSleepTimerValue"
                style="@style/AppGolosText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="выключено"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="10dp">
                <TextView
                    android:id="@+id/btnSleepUp"
                    android:layout_width="26dp"
                    android:layout_height="18dp"
                    android:gravity="center"
                    android:text="▲"
                    android:textColor="#FFFFFF" />
                <TextView
                    android:id="@+id/btnSleepDown"
                    android:layout_width="26dp"
                    android:layout_height="18dp"
                    android:gravity="center"
                    android:text="▼"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/itemStartMode"
        android:layout_width="0dp" android:layout_height="46dp" android:layout_marginTop="8dp"
        android:background="@drawable/bg_settings_row" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp"
        app:layout_constraintTop_toBottomOf="@id/btnSleepTimerSettings" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/folder" android:tint="#FFFFFF"/>
        <TextView style="@style/AppGolosText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:text="Выбор страницы при открытии приложения" android:textColor="#FFFFFF" android:textFontWeight="500" android:textSize="14sp"/>
        <ToggleButton
            android:id="@+id/tbStartMode"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:minWidth="190dp"
            android:background="@drawable/bg_settings_row"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textOff="Стартовая страница"
            android:textOn="Последний канал"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnAdvancedSettings"
        android:layout_width="0dp" android:layout_height="46dp" android:layout_marginTop="8dp"
        android:background="@drawable/bg_settings_row" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp"
        app:layout_constraintTop_toBottomOf="@id/itemStartMode" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/settings" android:tint="#FFFFFF"/>
        <TextView style="@style/AppGolosText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:text="Дополнительные настройки" android:textColor="#FFFFFF" android:textFontWeight="500" android:textSize="14sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnUserSettings"
        android:layout_width="0dp" android:layout_height="46dp" android:layout_marginTop="8dp"
        android:background="@drawable/bg_settings_row" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp"
        app:layout_constraintTop_toBottomOf="@id/btnAdvancedSettings" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/profile" android:tint="#FFFFFF"/>
        <TextView style="@style/AppGolosText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:text="Настроить пользователя" android:textColor="#FFFFFF" android:textFontWeight="500" android:textSize="14sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/userSettingsPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="32dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/userAuthForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView android:id="@+id/tvUserSectionState" style="@style/AppGolosText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Имя пользователя" android:textColor="#FFFFFF" android:textSize="14sp"/>
            <EditText android:id="@+id/etUserLoginInline" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="8dp" android:background="@drawable/bg_settings_row" android:hint="введите логин" android:paddingHorizontal="14dp" android:textColor="#FFFFFF" android:textColorHint="#66FFFFFF"/>
            <TextView android:id="@+id/tvUserTokenLabel" style="@style/AppGolosText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Токен" android:textColor="#FFFFFF" android:textSize="14sp"/>
            <EditText android:id="@+id/etUserTokenInline" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="8dp" android:background="@drawable/bg_settings_row" android:hint="введите токен с сайта o.avff.ru" android:paddingHorizontal="14dp" android:textColor="#FFFFFF" android:textColorHint="#66FFFFFF"/>
            <TextView android:id="@+id/btnUserAuthInline" style="@style/AppGolosText" android:layout_width="148dp" android:layout_height="44dp" android:layout_gravity="end" android:layout_marginTop="22dp" android:background="@drawable/bg_settings_row" android:gravity="center" android:text="Войти" android:textColor="#FFFFFF" android:textSize="18sp"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/userAuthorizedView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView android:id="@+id/tvAuthorizedLabel" style="@style/AppGolosText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Вы авторизовались как" android:textColor="#FFFFFF" android:textSize="14sp"/>
            <TextView android:id="@+id/tvAuthorizedName" style="@style/AppGolosText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="28sp" android:textStyle="bold"/>
            <TextView android:id="@+id/btnChangeUserInline" style="@style/AppGolosText" android:layout_width="220dp" android:layout_height="40dp" android:layout_marginTop="8dp" android:background="@drawable/bg_settings_row" android:gravity="center" android:text="Сменить пользователя" android:textColor="#FFFFFF" android:textSize="16sp"/>
        </LinearLayout>
        <TextView android:id="@+id/tvUserFooterHint" style="@style/AppGolosText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Данные для входа в приложение можно получить на сайте o.avff.ru, авторизовавшись через VK или Telegram\nTelegram-бот для поддержки @oportal_bot" android:textColor="#B3FFFFFF" android:textSize="12sp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
