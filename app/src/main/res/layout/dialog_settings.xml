<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:padding="0dp">

    <TextView
        android:id="@+id/tvSettingsTitle"
        android:visibility="gone"
        style="@style/AppGolosText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Настройки"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvSettingsBack"
        style="@style/AppGolosText"
        android:elevation="12dp"
        android:translationZ="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="0dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="10dp"
        android:paddingVertical="1dp"
        android:text="назад"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/btnPlaylistSettings"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_settings_row"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSettingsBack">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/list"
            android:tint="#FFFFFF" />

        <TextView
            style="@style/AppGolosText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="Настроить плейлисты"
            android:textColor="#FFFFFF"
            android:textFontWeight="500"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnEpgSelect"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_settings_row"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnPlaylistSettings">

        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/epg" android:tint="#FFFFFF"/>
        <TextView style="@style/AppGolosText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:text="Настройка программы передач (EPG)" android:textColor="#FFFFFF" android:textFontWeight="500" android:textSize="14sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnSleepTimerSettings"
        android:layout_width="0dp" android:layout_height="46dp" android:layout_marginTop="8dp"
        android:background="@drawable/bg_settings_row" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp"
        app:layout_constraintTop_toBottomOf="@id/btnEpgSelect" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/timer" android:tint="#FFFFFF"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView android:id="@+id/tvSleepTimerTitle" style="@style/AppGolosText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Таймер сна" android:textColor="#FFFFFF" android:textFontWeight="500" android:textSize="14sp"/>
            <TextView
                android:id="@+id/tvSleepTimerHint"
                style="@style/AppGolosText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Телефон: нажимайте на пункт для смены значения • Пульт: нажимайте ОК для смены значения"
                android:textColor="#99FFFFFF"
                android:textSize="6sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/tvSleepTimerValue"
                style="@style/AppGolosText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="выключено"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="10dp">
                <TextView
                    android:id="@+id/btnSleepUp"
                    android:layout_width="26dp"
                    android:layout_height="18dp"
                    android:gravity="center"
                    android:text="▲"
                    android:textColor="#FFFFFF" />
                <TextView
                    android:id="@+id/btnSleepDown"
                    android:layout_width="26dp"
                    android:layout_height="18dp"
                    android:gravity="center"
                    android:text="▼"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/itemStartMode"
        android:layout_width="0dp" android:layout_height="46dp" android:layout_marginTop="8dp"
        android:background="@drawable/bg_settings_row" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp"
        app:layout_constraintTop_toBottomOf="@id/btnSleepTimerSettings" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/folder" android:tint="#FFFFFF"/>
        <TextView style="@style/AppGolosText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:text="Выбор страницы при открытии приложения" android:textColor="#FFFFFF" android:textFontWeight="500" android:textSize="14sp"/>
        <ToggleButton
            android:id="@+id/tbStartMode"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:minWidth="190dp"
            android:background="@drawable/bg_settings_row"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textOff="Стартовая страница"
            android:textOn="Последний канал"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnAdvancedSettings"
        android:layout_width="0dp" android:layout_height="46dp" android:layout_marginTop="8dp"
        android:background="@drawable/bg_settings_row" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp"
        app:layout_constraintTop_toBottomOf="@id/itemStartMode" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/settings" android:tint="#FFFFFF"/>
        <TextView style="@style/AppGolosText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:text="Дополнительные настройки" android:textColor="#FFFFFF" android:textFontWeight="500" android:textSize="14sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnUserSettings"
        android:layout_width="0dp" android:layout_height="46dp" android:layout_marginTop="8dp"
        android:background="@drawable/bg_settings_row" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp"
        app:layout_constraintTop_toBottomOf="@id/btnAdvancedSettings" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/profile" android:tint="#FFFFFF"/>
        <TextView style="@style/AppGolosText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:text="Настроить пользователя" android:textColor="#FFFFFF" android:textFontWeight="500" android:textSize="14sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnExportDebugLog"
        android:layout_width="0dp" android:layout_height="46dp" android:layout_marginTop="8dp"
        android:background="@drawable/bg_settings_row" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp"
        app:layout_constraintTop_toBottomOf="@id/btnUserSettings" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/folder" android:tint="#FFFFFF"/>
        <TextView style="@style/AppGolosText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:text="Экспорт debug лога" android:textColor="#FFFFFF" android:textFontWeight="500" android:textSize="14sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/playlistSettingsPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="32dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            style="@style/AppGolosText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Сторонние плейлисты"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <EditText android:id="@+id/etPlaylistName1" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="0.33" android:background="@drawable/bg_settings_row" android:hint="название плейлиста" android:paddingHorizontal="12dp" android:textColor="#FFFFFF" android:textColorHint="#66FFFFFF" android:textSize="16sp"/>
            <EditText android:id="@+id/etPlaylistUrl1" android:layout_width="0dp" android:layout_height="40dp" android:layout_marginStart="8dp" android:layout_weight="0.67" android:background="@drawable/bg_settings_row" android:hint="введите ссылку на плейлист вида https://example.com/playlist.m3u8" android:paddingHorizontal="12dp" android:textColor="#FFFFFF" android:textColorHint="#66FFFFFF" android:textSize="16sp"/>
            <ImageView android:id="@+id/ivPlaylistToggle1" android:layout_width="48dp" android:layout_height="28dp" android:layout_marginStart="8dp" android:src="@drawable/toggleright"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <EditText android:id="@+id/etPlaylistName2" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="0.33" android:background="@drawable/bg_settings_row" android:hint="название плейлиста" android:paddingHorizontal="12dp" android:textColor="#FFFFFF" android:textColorHint="#66FFFFFF" android:textSize="16sp"/>
            <EditText android:id="@+id/etPlaylistUrl2" android:layout_width="0dp" android:layout_height="40dp" android:layout_marginStart="8dp" android:layout_weight="0.67" android:background="@drawable/bg_settings_row" android:hint="введите ссылку на плейлист вида https://example.com/playlist.m3u8" android:paddingHorizontal="12dp" android:textColor="#FFFFFF" android:textColorHint="#66FFFFFF" android:textSize="16sp"/>
            <ImageView android:id="@+id/ivPlaylistToggle2" android:layout_width="48dp" android:layout_height="28dp" android:layout_marginStart="8dp" android:src="@drawable/toggleright"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <EditText android:id="@+id/etPlaylistName3" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="0.33" android:background="@drawable/bg_settings_row" android:hint="название плейлиста" android:paddingHorizontal="12dp" android:textColor="#FFFFFF" android:textColorHint="#66FFFFFF" android:textSize="16sp"/>
            <EditText android:id="@+id/etPlaylistUrl3" android:layout_width="0dp" android:layout_height="40dp" android:layout_marginStart="8dp" android:layout_weight="0.67" android:background="@drawable/bg_settings_row" android:hint="введите ссылку на плейлист вида https://example.com/playlist.m3u8" android:paddingHorizontal="12dp" android:textColor="#FFFFFF" android:textColorHint="#66FFFFFF" android:textSize="16sp"/>
            <ImageView android:id="@+id/ivPlaylistToggle3" android:layout_width="48dp" android:layout_height="28dp" android:layout_marginStart="8dp" android:src="@drawable/toggleright"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:gravity="end">
            <TextView android:id="@+id/btnSavePlaylistSettings" style="@style/AppGolosText" android:layout_width="160dp" android:layout_height="42dp" android:background="@drawable/bg_settings_row" android:gravity="center" android:text="Сохранить" android:textColor="#FFFFFF" android:textSize="16sp"/>
            <TextView android:id="@+id/btnRefreshPlaylistSettings" style="@style/AppGolosText" android:layout_width="160dp" android:layout_height="42dp" android:layout_marginStart="10dp" android:background="@drawable/bg_settings_row" android:gravity="center" android:text="Обновить" android:textColor="#FFFFFF" android:textSize="16sp"/>
        </LinearLayout>

        <TextView
            style="@style/AppGolosText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="На текущий момент можно добавить до 3 плейлистов, поддерживаются форматы M3U/M3U8"
            android:textColor="#B3FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    

    <LinearLayout
        android:id="@+id/epgSettingsPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="39dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/ivEpgToggle1" android:layout_width="48dp" android:layout_height="28dp" android:src="@drawable/toggleright"/>
            <EditText android:id="@+id/etEpgUrl1" android:layout_width="0dp" android:layout_height="40dp" android:layout_marginStart="8dp" android:layout_weight="1" android:background="@drawable/bg_settings_row" android:hint="введите ссылку EPG" android:paddingHorizontal="12dp" android:textColor="#FFFFFF" android:textColorHint="#66FFFFFF" android:textSize="16sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/ivEpgToggle2" android:layout_width="48dp" android:layout_height="28dp" android:src="@drawable/toggleright"/>
            <EditText android:id="@+id/etEpgUrl2" android:layout_width="0dp" android:layout_height="40dp" android:layout_marginStart="8dp" android:layout_weight="1" android:background="@drawable/bg_settings_row" android:hint="введите ссылку EPG" android:paddingHorizontal="12dp" android:textColor="#FFFFFF" android:textColorHint="#66FFFFFF" android:textSize="16sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/ivEpgToggle3" android:layout_width="48dp" android:layout_height="28dp" android:src="@drawable/toggleright"/>
            <EditText android:id="@+id/etEpgUrl3" android:layout_width="0dp" android:layout_height="40dp" android:layout_marginStart="8dp" android:layout_weight="1" android:background="@drawable/bg_settings_row" android:hint="введите ссылку EPG" android:paddingHorizontal="12dp" android:textColor="#FFFFFF" android:textColorHint="#66FFFFFF" android:textSize="16sp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView style="@style/AppGolosText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Интервал обновления" android:textColor="#FFFFFF" android:textSize="14sp"/>
            <ToggleButton android:id="@+id/tbEpgRefreshInterval" android:layout_width="wrap_content" android:layout_height="30dp" android:minWidth="150dp" android:background="@drawable/bg_settings_row" android:textAllCaps="false" android:textColor="#FFFFFF" android:textOff="1 день" android:textOn="1 день" android:textSize="12sp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:gravity="end">
            <TextView android:id="@+id/btnSaveEpgSettings" style="@style/AppGolosText" android:layout_width="160dp" android:layout_height="42dp" android:background="@drawable/bg_settings_row" android:gravity="center" android:text="Сохранить" android:textColor="#FFFFFF" android:textSize="16sp"/>
            <TextView android:id="@+id/btnRefreshEpgSettings" style="@style/AppGolosText" android:layout_width="160dp" android:layout_height="42dp" android:layout_marginStart="10dp" android:background="@drawable/bg_settings_row" android:gravity="center" android:text="Обновить" android:textColor="#FFFFFF" android:textSize="16sp"/>
        </LinearLayout>
    </LinearLayout>
<ScrollView
        android:id="@+id/userSettingsPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="39dp"
        android:fillViewport="true"
        android:scrollbars="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/userAuthForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
        <TextView android:id="@+id/tvUserSectionState" style="@style/AppGolosText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Имя пользователя" android:textColor="#FFFFFF" android:textSize="16sp"/>
            <EditText android:id="@+id/etUserLoginInline" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="6dp" android:background="@drawable/bg_settings_row" android:hint="введите логин" android:paddingHorizontal="12dp" android:textColor="#FFFFFF" android:textColorHint="#66FFFFFF"/>
            <TextView android:id="@+id/tvUserTokenLabel" style="@style/AppGolosText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Токен" android:textColor="#FFFFFF" android:textSize="16sp"/>
            <EditText android:id="@+id/etUserTokenInline" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="6dp" android:background="@drawable/bg_settings_row" android:hint="введите токен с сайта o.avff.ru" android:paddingHorizontal="12dp" android:textColor="#FFFFFF" android:textColorHint="#66FFFFFF"/>
            <TextView android:id="@+id/btnUserAuthInline" style="@style/AppGolosText" android:layout_width="128dp" android:layout_height="38dp" android:layout_gravity="end" android:layout_marginTop="16dp" android:background="@drawable/bg_settings_row" android:gravity="center" android:text="Войти" android:textColor="#FFFFFF" android:textSize="16sp"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/userAuthorizedView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView android:id="@+id/tvAuthorizedLabel" style="@style/AppGolosText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Вы авторизовались как" android:textColor="#FFFFFF" android:textSize="16sp"/>
            <TextView android:id="@+id/tvAuthorizedName" style="@style/AppGolosText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"/>
            <TextView android:id="@+id/btnChangeUserInline" style="@style/AppGolosText" android:layout_width="190dp" android:layout_height="36dp" android:layout_marginTop="6dp" android:background="@drawable/bg_settings_row" android:gravity="center" android:text="Сменить пользователя" android:textColor="#FFFFFF" android:textSize="16sp"/>
            <TextView android:id="@+id/tvAuthorizedTokenLabel" style="@style/AppGolosText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="Токен" android:textColor="#FFFFFF" android:textSize="16sp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                <TextView android:id="@+id/tvAuthorizedTokenValue" style="@style/AppGolosText" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:background="@drawable/bg_settings_row" android:gravity="center_vertical" android:paddingHorizontal="12dp" android:textColor="#E6FFFFFF" android:textSize="11sp"/>
                <TextView android:id="@+id/btnChangeTokenInline" style="@style/AppGolosText" android:layout_width="116dp" android:layout_height="40dp" android:layout_marginStart="8dp" android:background="@drawable/bg_settings_row" android:gravity="center" android:text="Сменить" android:textColor="#FFFFFF" android:textSize="16sp"/>
            </LinearLayout>
            <TextView android:id="@+id/tvAuthorizedPlaylistLabel" style="@style/AppGolosText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Плейлист" android:textColor="#FFFFFF" android:textSize="16sp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                <TextView android:id="@+id/tvAuthorizedPlaylistValue" style="@style/AppGolosText" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:background="@drawable/bg_settings_row" android:gravity="center_vertical" android:paddingHorizontal="12dp" android:textColor="#E6FFFFFF" android:textSize="11sp"/>
                <TextView android:id="@+id/btnOpenPlaylistInline" style="@style/AppGolosText" android:layout_width="116dp" android:layout_height="40dp" android:layout_marginStart="8dp" android:background="@drawable/bg_settings_row" android:gravity="center" android:text="Перейти" android:textColor="#FFFFFF" android:textSize="16sp"/>
            </LinearLayout>
            <TextView android:id="@+id/tvAuthorizedHint" style="@style/AppGolosText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="двойной тап позволяет скопировать ссылку на плейлист или токен, но с пульта даже не пытайтесь. вот так." android:textColor="#B3FFFFFF" android:textSize="10sp"/>
        </LinearLayout>
        <TextView android:id="@+id/tvUserFooterHint" style="@style/AppGolosText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Данные для входа в приложение можно получить на сайте o.avff.ru, авторизовавшись через VK или Telegram\nTelegram-бот для поддержки @oportal_bot" android:textColor="#B3FFFFFF" android:textSize="12sp"/>
    </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
