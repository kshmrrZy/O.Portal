<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/bg_glass_panel">

    <TextView
        style="@style/WhiteTitleTextShadow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Настройки"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="18sp"
        android:paddingBottom="10dp" />

    <TextView
        android:id="@+id/btnPlaylistSettings"
        style="@style/WhiteTitleTextShadow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_watch_button"
        android:gravity="center"
        android:padding="12dp"
        android:text="Настройка плейлиста"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnEpgSelect"
        style="@style/WhiteTitleTextShadow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_watch_button"
        android:gravity="center"
        android:padding="12dp"
        android:text="Выбор EPG"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

    <ToggleButton
        android:id="@+id/tbStartMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textOff="Старт: Стартовая страница"
        android:textOn="Старт: Последний канал"
        android:textColor="#FFFFFF"
        android:background="@drawable/bg_watch_button" />

    <ToggleButton
        android:id="@+id/tbShowLockButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textOff="Кнопка блокировки: скрыта"
        android:textOn="Кнопка блокировки: видна"
        android:textColor="#FFFFFF"
        android:background="@drawable/bg_watch_button" />

    <TextView
        android:id="@+id/btnCloseSettingsDialog"
        style="@style/WhiteTitleTextShadow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_watch_button"
        android:gravity="center"
        android:padding="12dp"
        android:text="Закрыть"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

</LinearLayout>
