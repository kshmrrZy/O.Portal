<ScrollView
        android:id="@+id/userSettingsPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="39dp"
        android:fillViewport="true"
        android:scrollbars="none"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/userAuthForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
        <TextView android:id="@+id/tvUserSectionState" style="@style/AppGolosText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Имя пользователя" android:textColor="#FFFFFF" android:textSize="16sp"/>
            <EditText android:id="@+id/etUserLoginInline" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="6dp" android:background="@drawable/bg_settings_row" android:hint="введите логин" android:paddingHorizontal="12dp" android:textColor="#FFFFFF" android:textColorHint="#66FFFFFF"/>
            <TextView android:id="@+id/tvUserTokenLabel" style="@style/AppGolosText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Токен" android:textColor="#FFFFFF" android:textSize="16sp"/>
            <EditText android:id="@+id/etUserTokenInline" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="6dp" android:background="@drawable/bg_settings_row" android:hint="введите токен с сайта o.avff.ru" android:paddingHorizontal="12dp" android:textColor="#FFFFFF" android:textColorHint="#66FFFFFF"/>
            <TextView android:id="@+id/btnUserAuthInline" android:focusable="true" android:focusableInTouchMode="false" style="@style/AppGolosText" android:layout_width="128dp" android:layout_height="38dp" android:layout_gravity="end" android:layout_marginTop="16dp" android:background="@drawable/bg_settings_row" android:gravity="center" android:text="Войти" android:textColor="#FFFFFF" android:textSize="16sp"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/userAuthorizedView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView android:id="@+id/tvAuthorizedLabel" style="@style/AppGolosText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Вы авторизовались как" android:textColor="#99FFFFFF" android:textSize="12sp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/tvAuthorizedName" style="@style/AppGolosText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold"/>
                <TextView android:id="@+id/btnChangeUserInline" android:focusable="true" android:focusableInTouchMode="false" style="@style/AppGolosText" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginStart="12dp" android:background="@drawable/bg_settings_row" android:gravity="center" android:paddingHorizontal="14dp" android:text="Сменить пользователя" android:textColor="#FFFFFF" android:textSize="13sp"/>
            </LinearLayout>
            <TextView android:id="@+id/tvAuthorizedTokenLabel" style="@style/AppGolosText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Токен" android:textColor="#FFFFFF" android:textSize="16sp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                <TextView android:id="@+id/tvAuthorizedTokenValue" style="@style/AppGolosText" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:background="@drawable/bg_settings_row" android:gravity="center_vertical" android:paddingHorizontal="12dp" android:textColor="#E6FFFFFF" android:textSize="11sp"/>
                <TextView android:id="@+id/btnChangeTokenInline" android:focusable="true" android:focusableInTouchMode="false" style="@style/AppGolosText" android:layout_width="116dp" android:layout_height="40dp" android:layout_marginStart="8dp" android:background="@drawable/bg_settings_row" android:gravity="center" android:text="Сменить" android:textColor="#FFFFFF" android:textSize="16sp"/>
            </LinearLayout>
            <TextView android:id="@+id/tvAuthorizedPlaylistLabel" style="@style/AppGolosText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Плейлист" android:textColor="#FFFFFF" android:textSize="16sp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                <TextView android:id="@+id/tvAuthorizedPlaylistValue" style="@style/AppGolosText" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:background="@drawable/bg_settings_row" android:gravity="center_vertical" android:paddingHorizontal="12dp" android:textColor="#E6FFFFFF" android:textSize="11sp"/>
                <TextView android:id="@+id/btnOpenPlaylistInline" android:focusable="true" android:focusableInTouchMode="false" style="@style/AppGolosText" android:layout_width="116dp" android:layout_height="40dp" android:layout_marginStart="8dp" android:background="@drawable/bg_settings_row" android:gravity="center" android:text="Перейти" android:textColor="#FFFFFF" android:textSize="16sp"/>
            </LinearLayout>
            <TextView android:id="@+id/tvAuthorizedHint" style="@style/AppGolosText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="двойной тап позволяет скопировать ссылку на плейлист или токен, но с пульта даже не пытайтесь. вот так." android:textColor="#B3FFFFFF" android:textSize="10sp"/>
        </LinearLayout>
        <TextView android:id="@+id/tvUserFooterHint" style="@style/AppGolosText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Данные для входа в приложение можно получить на сайте o.avff.pw, авторизовавшись через VK или Telegram\nTelegram-бот для поддержки @oportal_bot" android:textColor="#B3FFFFFF" android:textSize="12sp"/>
    </LinearLayout>

    </ScrollView>

