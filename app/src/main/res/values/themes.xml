<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- In-app theme (also used as postSplashScreenTheme). -->
    <style name="Base.Theme.O_portal_OTT" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:fontFamily">@font/main_font</item>
        <item name="fontFamily">@font/main_font</item>
        <item name="android:textViewStyle">@style/AppTextView</item>
        <item name="android:buttonStyle">@style/AppButton</item>
        <item name="android:windowBackground">@drawable/bg_home_screen</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
    </style>

    <style name="Theme.O_portal_OTT.Main" parent="Base.Theme.O_portal_OTT" />

    <!-- Cold start: keep system splash until activity draws our gradient overlay.
         Android SplashScreen API cannot host a TextView — icon must be a drawable.
         Use square wordmark (splash_wordmark_icon.png, ~1000x1000): the platform
         centers it in a circular/mask icon slot; the wide 1000x185 asset would crop.
         In-app launchSplashLogo TextView mirrors the same wordmark with Medium/Bold spans. -->
    <style name="Theme.O_portal_OTT" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/oportal_splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_wordmark_icon</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/oportal_splash_bg</item>
        <item name="postSplashScreenTheme">@style/Theme.O_portal_OTT.Main</item>
    </style>
</resources>
