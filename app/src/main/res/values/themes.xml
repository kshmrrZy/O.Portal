<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.O_portal_OTT" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="android:fontFamily">@font/main_font</item>
        <item name="fontFamily">@font/main_font</item>
        <item name="android:textViewStyle">@style/AppTextView</item>
        <item name="android:buttonStyle">@style/AppButton</item>
        <!-- Shown while the activity inflates (replaces plain black/grey flash).
             Posters: drawable-sw{480,720,1080,2160}dp-nodpi/oportal_bg.png;
             default drawable-nodpi/oportal_bg.png is 480 for SW &lt; 480. nodpi avoids density upscale. -->
        <item name="android:windowBackground">@drawable/oportal_bg</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
    </style>

    <style name="Theme.O_portal_OTT" parent="Base.Theme.O_portal_OTT" />


</resources>