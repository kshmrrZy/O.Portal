<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12+ SplashScreen API: windowSplashScreenBackground is color-only.
      Bitmap posters stay on android:windowBackground / launch overlay ImageView.
    -->
    <style name="Theme.O_portal_OTT" parent="Base.Theme.O_portal_OTT">
        <item name="android:windowSplashScreenBackground">@color/oportal_splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_transparent_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBrandingImage">@null</item>
    </style>
</resources>
