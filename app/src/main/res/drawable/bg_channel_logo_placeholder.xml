<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded square plate + image glyph — used when a channel logo is missing or fails to load. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#402A2A2A" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/ic_channel_image_placeholder"
        android:gravity="center"
        android:left="7dp"
        android:top="7dp"
        android:right="7dp"
        android:bottom="7dp" />
</layer-list>
