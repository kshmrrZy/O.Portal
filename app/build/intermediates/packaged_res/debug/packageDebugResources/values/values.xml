    <style name="AppTextView" parent="android:style/Widget.TextView">
        <item name="android:fontFamily">@font/main_font</item>
        <item name="fontFamily">@font/main_font</item>
    </style>
    <style name="Base.Theme.O_portal_OTT" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        
        
        <item name="android:fontFamily">@font/main_font</item>
        <item name="fontFamily">@font/main_font</item>
        <item name="android:textViewStyle">@style/AppTextView</item>
        <item name="android:buttonStyle">@style/AppButton</item>
    </style>
    <style name="Theme.O_portal_OTT" parent="Base.Theme.O_portal_OTT"/>
    <style name="WhiteTextShadow" parent="AppGolosText">
        <item name="android:shadowColor">#80000000</item>
        <item name="android:shadowDx">0</item>
