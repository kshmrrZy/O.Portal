<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="purple_700">#FF3700B3</color>
    <color name="white">#FFFFFFFF</color>
    <string name="app_name">O.Portal</string>
    <string name="home_power_button">Закрыть приложение</string>
    <string name="home_settings_button">Открыть настройки</string>
    <style name="AppButton" parent="android:style/Widget.Button">
        <item name="android:fontFamily">@font/main_font</item>
        <item name="fontFamily">@font/main_font</item>
    </style>
    <style name="AppGolosText">
        <item name="android:fontFamily">@font/main_font</item>
        <item name="fontFamily">@font/main_font</item>
